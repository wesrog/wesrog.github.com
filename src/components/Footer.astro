<footer class="site-footer">
  <div class="wrapper"><div class="footer-inner">
    <p class="tagline">Thoughts and waves from Wes Rogers.</p>
    <nav class="social-links">
      <a href="https://twitter.com/wesrog" target="_blank" rel="noopener noreferrer" aria-label="Twitter/X">Twitter/X</a>
      <a href="https://github.com/wesrog" target="_blank" rel="noopener noreferrer" aria-label="GitHub">GitHub</a>
      <a href="https://linkedin.com/in/wesrog" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">LinkedIn</a>
      <a href="https://flickr.com/photos/wesr" target="_blank" rel="noopener noreferrer" aria-label="Flickr">Flickr</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div></div>
</footer>

<style>
.site-footer {
  padding: var(--spacing) 0 calc(var(--spacing) * 1.5);
  margin-top: calc(var(--spacing) * 2.5);
}
.footer-inner {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 0.5em 1.5em;
  border-top: 1px solid var(--color-border);
  padding-top: var(--spacing);
}
.tagline {
  color: var(--color-muted);
  font-size: 0.8em;
  margin: 0;
}
.social-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4em 1.1em;
}
.social-links a, .social-links a:visited {
  color: var(--color-muted);
  font-size: 0.8em;
  text-decoration: none;
}
.social-links a:hover { color: var(--color-link); }
</style>
