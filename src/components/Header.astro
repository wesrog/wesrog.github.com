---
const path = Astro.url.pathname;
const isPosts = path === '/' || /^\/\d+\/?$/.test(path) || path.startsWith('/blog/');
const isArchive = path.startsWith('/archive');
const isAbout = path.startsWith('/about');
---
<header class="site-header">
  <div class="wrapper">
    <a class="site-title" href="/" aria-label="WR home">
      <svg width="50" height="26" viewBox="0 0 62 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <polygon class="logo-w" fill-opacity="0.4" points="0 0 6.17951426 0 12.6842661 22.72 19.9324182 0 24.0675818 0 31.594509 22.1257143 37.8204857 0 44 0 34.4751848 32 29.2249208 32 21.9767687 10.6514286 14.7750792 32 9.1531151 32"></polygon>
        <path class="logo-r" fill-opacity="0.8" d="M38,0 L49.4626866,0 C52.8059869,0 55.4402889,0.815229943 57.3656716,2.44571429 C59.2910544,4.07619863 60.2537313,6.49141257 60.2537313,9.69142857 C60.2537313,11.9162016 59.7910494,13.7371358 58.8656716,15.1542857 C57.9402939,16.5714357 56.6268742,17.7066624 54.9253731,18.56 L62,32 L55.5970149,32 L49.5522388,20.1142857 L43.7313433,20.1142857 L43.7313433,32 L38,32 L38,0 Z M47.4,16 L43,16 L43,5 L47.6340426,5 C49.8808623,5 51.5035411,5.46238476 52.5021277,6.38716814 C53.5007142,7.31195153 54,8.66665774 54,10.4513274 C54,14.150461 51.800022,16 47.4,16 Z"></path>
      </svg>
    </a>
    <nav>
      <a href="/" aria-current={isPosts ? 'page' : undefined}>Posts</a>
      <a href="/archive/" aria-current={isArchive ? 'page' : undefined}>Archive</a>
      <a href="/about" aria-current={isAbout ? 'page' : undefined}>About</a>
      <button class="theme-toggle" type="button" aria-label="Switch theme (auto, light, dark)" title="Theme: auto / light / dark">
        <svg class="icon-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16z" class="fill" /></svg>
        <svg class="icon-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <svg class="icon-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
      </button>
    </nav>
  </div>
</header>

<style>
.site-header {
  padding: 22px 0;
  margin-bottom: calc(var(--spacing) * 1.25);
}
.site-header .wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.site-title {
  display: flex;
  text-decoration: none;
  color: var(--color-text);
}
nav {
  display: flex;
  align-items: center;
  gap: 1.1em;
  font-size: 0.9em;
}
nav a {
  text-decoration: none;
  color: var(--color-muted);
}
nav a:visited { color: var(--color-muted); }
nav a:hover, nav a[aria-current="page"] { color: var(--color-text); }
.logo-w { fill: var(--color-text); }
.logo-r { fill: var(--color-link); }

.theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  padding: 0;
  margin-left: -0.3em;
  border: none;
  border-radius: 50%;
  background: none;
  color: var(--color-muted);
  cursor: pointer;
}
.theme-toggle:hover { color: var(--color-text); background: var(--color-code-bg); }
.theme-toggle svg {
  width: 17px;
  height: 17px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  display: none;
}
.theme-toggle .fill { fill: currentColor; stroke: none; }
:global(:root[data-theme="auto"]) .icon-auto,
:global(:root[data-theme="light"]) .icon-light,
:global(:root[data-theme="dark"]) .icon-dark { display: block; }
</style>
